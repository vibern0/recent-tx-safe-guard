{
  "name": "recent-tx-safe-guard",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run security-core:build && npm run app:build && npm run landing:build",
    "test": "npm run security-core:test && npm run app:test && npm run landing:test",
    "check": "npm run security-core:check && npm run app:test && npm run landing:test",
    "security-core:build": "npm --prefix packages/security-core run build",
    "security-core:test": "npm --prefix packages/security-core test",
    "security-core:test:unit": "npm --prefix packages/security-core run test:unit",
    "security-core:test:integration": "npm --prefix packages/security-core run test:integration",
    "security-core:test:invariant": "npm --prefix packages/security-core run test:invariant",
    "security-core:check": "npm --prefix packages/security-core run check",
    "security-core:coverage": "npm --prefix packages/security-core run coverage",
    "security-core:slither": "npm --prefix packages/security-core run slither",
    "security-core:security:check": "npm --prefix packages/security-core run security:check",
    "security-core:plan:deployment": "npm --prefix packages/security-core run plan:deployment",
    "security-core:verify:dependencies": "npm --prefix packages/security-core run verify:dependencies",
    "security-core:verify:deployment": "npm --prefix packages/security-core run verify:deployment",
    "security-core:watch:activity": "npm --prefix packages/security-core run watch:activity",
    "security-core:rehearse": "npm --prefix packages/security-core run rehearse",
    "security-core:package:sepolia-rehearsal": "npm --prefix packages/security-core run package:sepolia-rehearsal",
    "app:dev": "npm --prefix apps/app run dev",
    "app:build": "npm --prefix apps/app run build",
    "app:preview": "npm --prefix apps/app run preview",
    "app:lint": "npm --prefix apps/app run lint",
    "app:format": "npm --prefix apps/app run format",
    "app:test": "npm --prefix apps/app test",
    "app:test:watch": "npm --prefix apps/app run test:watch",
    "landing:dev": "npm --prefix apps/landing run dev",
    "landing:build": "npm --prefix apps/landing run build",
    "landing:preview": "npm --prefix apps/landing run preview",
    "landing:lint": "npm --prefix apps/landing run lint",
    "landing:format": "npm --prefix apps/landing run format",
    "landing:test": "npm --prefix apps/landing test",
    "landing:test:watch": "npm --prefix apps/landing run test:watch"
  }
}
